# Copy to deploy/local.env and fill in your target machine.
# deploy/local.env is gitignored, so private host details never reach the repo.
REMOTE="user@windows-host"                       # SSH target (Windows OpenSSH server)
#WIN_DIR='C:\Users\<user>\sensor_reader'         # default: derived from the SSH user name
#WIN_PY='C:\Users\<user>\Python312\python.exe'   # default: `python` on the target's PATH
