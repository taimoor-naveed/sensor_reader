# Copy to deploy/local.env and fill in your target machine.
# deploy/local.env is gitignored, so private host details never reach the repo.
REMOTE="user@ubuntu-host"        # SSH target (key auth); the user part is also the app user
#APP_DIR="sensor_reader"         # app dir on the target; relative paths are under $HOME
#REMOTE_PY="python3"             # interpreter used to create the venv
